<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_messi_commitment_tree" model="ir.ui.view">
        <field name="name">messi.commitment.tree</field>
        <field name="model">messi.commitment</field>
        <field name="arch" type="xml">
            <tree decoration-danger="state == 'broken'" decoration-success="state == 'kept'">
                <field name="module_id"/>
                <field name="subject_name"/>
                <field name="action_text"/>
                <field name="owner_id"/>
                <field name="due_at"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_messi_commitment_form" model="ir.ui.view">
        <field name="name">messi.commitment.form</field>
        <field name="model">messi.commitment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state != 'open'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="module_id"/>
                            <field name="subject_name"/>
                            <field name="owner_id"/>
                        </group>
                        <group>
                            <field name="due_at"/>
                            <field name="resolved_at"/>
                            <field name="spawned_cycle_id" string="Asked again in"/>
                        </group>
                    </group>
                    <field name="action_text" readonly="1"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_messi_commitments" model="ir.actions.act_window">
        <field name="name">Promises</field>
        <field name="res_model">messi.commitment</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_messi_broken" model="ir.actions.act_window">
        <field name="name">Broken promises</field>
        <field name="res_model">messi.commitment</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('state', '=', 'broken')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No broken promises.</p>
            <p>This is the list worth reading. Kept promises need no attention.</p>
        </field>
    </record>
</odoo>
